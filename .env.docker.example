APP_NAME=Progest
APP_ENV=production
APP_DOMAIN=sistema-hospital.com.br
APP_KEY=
APP_DEBUG=false
APP_URL=https://${APP_DOMAIN}
FRONTEND_URL=https://${APP_DOMAIN}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - Conecta ao serviço mysql do docker-compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=progest
DB_USERNAME=progest
DB_PASSWORD=progest_secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Credenciais Padrão de Provisionamento / Seeders
ADMIN_DEFAULT_EMAIL=adminti@gmail.com
ADMIN_DEFAULT_PASSWORD=
USER_DEFAULT_PASSWORD=
SANCTUM_EXPIRATION=480
API_RATE_LIMIT=300